{
  "name": "aestival-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "preview": "vite preview",
    "test:editor-layout": "esbuild scripts/editor-layout-state.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/aestival-editor-layout-state.test.mjs && node --test /tmp/aestival-editor-layout-state.test.mjs",
    "test:project-board": "esbuild scripts/project-board-state.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/aestival-project-board-state.test.mjs && node --test /tmp/aestival-project-board-state.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@shadcn/react": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@wailsio/runtime": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.26.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.56.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.14.1",
    "shiki": "^4.4.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.2.2",
    "vite": "^6.4.3"
  }
